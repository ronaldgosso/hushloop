{
  "name": "hushloop",
  "version": "1.1.4",
  "description": "Active Pomodoro desktop timer for Windows 11 with ambient music and distraction silencing",
  "author": "Ronald Gosso",
  "main": "dist-electron/main/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:renderer": "tsc && vite build",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package:exe": "npm run build:renderer && electron-builder --win nsis",
    "package:msi": "npm run build:renderer && electron-builder --win msi",
    "package:portable": "npm run build:renderer && electron-builder --win portable",
    "package:dir": "npm run build:renderer && electron-builder --win dir",
    "package:all": "npm run build:renderer && electron-builder --win nsis msi portable"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^2.1.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.1.2"
  }
}
