{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.hushloop.app",
  "productName": "HushLoop",
  "copyright": "Copyright © 2026 Ronald Gosso",
  "directories": {
    "output": "release"
  },
  "files": ["dist/**/*", "dist-electron/**/*"],
  "asarUnpack": [
    "**/favicon.ico",
    "**/favicon.svg",
    "**/icon.ico"
  ],
  "win": {
    "icon": "build/icon.ico",
    "publisherName": "Ronald Gosso",
    "legalTrademarks": "HushLoop by Ronald Gosso",
    "signAndEditExecutable": false,
    "forceCodeSigning": false,
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "msi",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      },
      {
        "target": "dir",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "HushLoop",
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}.${ext}"
  },
  "msi": {
    "oneClick": false,
    "perMachine": false,
    "runAfterFinish": true,
    "shortcutName": "HushLoop",
    "artifactName": "${productName}-${version}.${ext}"
  }
}
