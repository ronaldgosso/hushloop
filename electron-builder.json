{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.hushloop.app",
  "productName": "HushLoop",
  "copyright": "Copyright © 2026 Ronald Gosso",
  "directories": {
    "output": "release"
  },
  "files": ["dist/**/*", "dist-electron/**/*"],
  "win": {
    "publisherName": "Ronald Gosso",
    "legalTrademarks": "HushLoop by Ronald Gosso",
    "signAndEditExecutable": false,
    "forceCodeSigning": false,
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "msi",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      },
      {
        "target": "dir",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "HushLoop"
  },
  "msi": {
    "oneClick": false,
    "perMachine": false,
    "runAfterFinish": true,
    "shortcutName": "HushLoop"
  }
}
